:{"9":{"position":[[0,5]]}}}],["us",{"_index":2,"t":{"3":{"position":[[27,3]]}}}]],"pipeline":["stemmer"]}},{"documents":[{"i":1,"t":"App: Psychic AI","s":"Privacy Policy","u":"/WBBDocs/psychic-ai/","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/1",[0,0.288,1,0.288,2,0.288]]],"invertedIndex":[["ai",{"_index":2,"t":{"1":{"position":[[13,2]]}}}],["app",{"_index":0,"t":{"1":{"position":[[0,4]]}}}],["psychic",{"_index":1,"t":{"1":{"position":[[5,7]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":2,"t":"App: Psychic AI Last updated: 9 August 2026 This Privacy Policy outlines how Psychic AI (\"we,\" \"us,\" or \"our\") collects, uses, discloses, and protects the personal information of users (\"you\" or \"your\") when using the Psychic AI mobile application (\"the App\"). We are committed to respecting your privacy and ensuring the security of your personal information. By using the App, you consent to the practices described in this Privacy Policy.","s":"Privacy Policy","u":"/WBBDocs/psychic-ai/","h":"","p":1},{"i":4,"t":"We may collect and store certain personal information when you use the App, including but not limited to: Your name, email address, and other contact information provided during account registration. Information provided when seeking guidance or engaging in live chat sessions with psychics or advisors. Data generated by your use of the App, such as log files, device information, and usage statistics. We use this information for the following purposes: To provide and personalize the services offered by the App. To communicate with you, respond to inquiries, and deliver customer support. To improve the App, troubleshoot technical issues, and analyze usage patterns. To ensure the security and integrity of the App and its users.","s":"Information Collection and Use","u":"/WBBDocs/psychic-ai/","h":"#information-collection-and-use","p":1},{"i":6,"t":"We may share your personal information in the following circumstances: With trusted psychics, mediums, or advisors you choose to interact with through the App's chat features. Please note that these individuals are bound by confidentiality obligations. With service providers who assist us in operating the App, such as hosting, customer support, and analytics providers. These providers have access to your information only to perform their designated functions and are obligated to maintain its confidentiality. In response to legal requests or to comply with applicable laws, regulations, or legal processes. In connection with a merger, acquisition, or sale of all or a portion of our assets, where your information may be transferred as part of the transaction.","s":"Data Sharing and Disclosure","u":"/WBBDocs/psychic-ai/","h":"#data-sharing-and-disclosure","p":1},{"i":8,"t":"We take reasonable measures to protect the security of your personal information. However, no method of transmission or storage is 100% secure, and we cannot guarantee absolute security. We encourage you to use strong passwords, keep your login credentials confidential, and promptly notify us of any unauthorized use or security concerns.","s":"Data Security","u":"/WBBDocs/psychic-ai/","h":"#data-security","p":1},{"i":10,"t":"The App may contain links to third-party websites or services that are not owned or controlled by Psychic AI. We are not responsible for the privacy practices or content of such third parties. We recommend reviewing their respective privacy policies before engaging with them.","s":"Third-Party Links and Services","u":"/WBBDocs/psychic-ai/","h":"#third-party-links-and-services","p":1},{"i":12,"t":"We reserve the right to modify or update this Privacy Policy at any time. Any changes will be effective upon posting the updated policy within the App. We encourage you to review this Privacy Policy periodically for any updates.","s":"Changes to this Privacy Policy","u":"/WBBDocs/psychic-ai/","h":"#changes-to-this-privacy-policy","p":1},{"i":14,"t":"If you have any questions, concerns, or requests regarding this Privacy Policy, please contact us at vincenttrandeveloper@gmail.com. We will make reasonable efforts to address your inquiries and resolve any privacy-related issues. By continuing to use the Psychic AI App, you signify your acceptance of this Privacy Policy.","s":"Contact Us","u":"/WBBDocs/psychic-ai/","h":"#contact-us","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,0.323,1,0.584,2,1.288,3,1.646,4,1.144,5,1.646,6,1.646,7,1.646,8,0.896,9,0.782,10,1.646,11,1.144,12,0.896,13,1.646,14,1.144,15,0.782,16,0.782,17,1.144,18,1.646,19,1.144,20,1.646,21,1.144,22,1.144,23,0.813,24,1.646,25,1.144,26,1.646]],["t/4",[0,0.333,1,0.287,11,0.892,12,0.78,15,0.654,16,0.921,17,0.892,22,0.892,23,0.634,27,1.284,28,1.284,29,1.284,30,1.284,31,1.284,32,1.284,33,0.892,34,0.892,35,1.577,36,1.284,37,1.284,38,1.284,39,1.284,40,1.284,41,0.892,42,1.284,43,0.892,44,1.284,45,0.892,46,1.284,47,1.284,48,0.634,49,1.284,50,1.284,51,1.284,52,1.904,53,1.284,54,0.892,55,1.284,56,0.634,57,1.284,58,1.284,59,1.284,60,0.892,61,1.284,62,0.892,63,0.892,64,1.284,65,1.284,66,1.284,67,0.892,68,1.284,69,1.284,70,1.284]],["t/6",[0,0.169,1,0.305,15,0.468,16,0.807,19,0.946,35,1.632,43,0.946,45,0.946,48,0.672,54,0.946,56,0.672,62,0.946,63,0.946,71,1.361,72,1.361,73,1.361,74,1.361,75,1.361,76,1.361,77,1.361,78,1.361,79,1.361,80,0.946,81,1.361,82,1.361,83,1.361,84,1.381,85,1.988,86,1.361,87,1.361,88,1.361,89,1.361,90,1.361,91,1.361,92,1.361,93,1.361,94,1.361,95,0.946,96,1.988,97,0.946,98,1.361,99,1.361,100,1.361,101,1.361,102,1.361,103,1.361,104,1.361,105,1.361,106,1.361,107,1.361,108,1.361,109,1.361,110,1.361]],["t/8",[12,0.85,14,1.293,15,0.64,16,0.64,23,1.461,84,1.293,111,1.861,112,1.293,113,1.861,114,1.861,115,1.861,116,1.861,117,1.861,118,1.861,119,1.861,120,1.293,121,1.861,122,1.861,123,1.861,124,1.861,125,1.861,126,1.861,127,1.