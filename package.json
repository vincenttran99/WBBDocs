{
  "name": "wbbdocs",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:portal": "npm run build --workspace=apps/portal",
    "start:portal": "npm run start --workspace=apps/portal",
    "start:focus-timer": "npm run start --workspace=apps/focus-timer",
    "build:focus-timer": "npm run build --workspace=apps/focus-timer",
    "start:noise-complaint": "npm run start --workspace=apps/noise-complaint",
    "build:noise-complaint": "npm run build --workspace=apps/noise-complaint",
    "start:psychic-ai": "npm run start --workspace=apps/psychic-ai",
    "build:psychic-ai": "npm run build --workspace=apps/psychic-ai",
    "start:dayly": "npm run start --workspace=apps/dayly",
    "build:dayly": "npm run build --workspace=apps/dayly",
    "serve": "npm run build && node scripts/serve.js"
  },
  "engines": {
    "node": ">=22"
  }
}
