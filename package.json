{
  "name": "wbbdocs",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:portal": "npm run build --workspace=apps/portal",
    "build:app1": "npm run build --workspace=apps/app1",
    "build:app2": "npm run build --workspace=apps/app2",
    "start:portal": "npm run start --workspace=apps/portal",
    "start:app1": "npm run start --workspace=apps/app1",
    "start:app2": "npm run start --workspace=apps/app2"
  },
  "engines": {
    "node": ">=22"
  }
}
